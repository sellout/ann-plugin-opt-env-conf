cabal-version: 2.4
name:          ann-plugin-opt-env-conf
version:       0.1.0.0
synopsis:      OptEnvConf extended for GHC plugins with annotation support
description:
  Configuration parsing for GHC plugins using OptEnvConf.
  Replaces command-line argument handling with -fplugin-opt handling
  and adds source annotation handling as the highest priority source.

license:       LGPL-3.0-only
license-file:  LICENSE
author:        Greg Pfeil
maintainer:    greg@technomadic.org
category:      Development
build-type:    Simple
tested-with:
  GHC == 9.0.1,
  GHC == 9.2.1,
  GHC == 9.4.1,
  GHC == 9.6.1,
  GHC == 9.8.1,
  GHC == 9.10.1

library
  exposed-modules:
    AnnPluginOptEnvConf
    AnnPluginOptEnvConf.Annotation
    AnnPluginOptEnvConf.PluginOpts
    AnnPluginOptEnvConf.Run
    AnnPluginOptEnvConf.Setting

  build-depends:
    , aeson >= 2.0
    , base < 5
    , containers
    , ghc >= 9.0
    , opt-env-conf >= 0.14
    , text

  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall
